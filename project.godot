; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="EccentriCity"
config/description="Eccentri City — procedural voxel city of weird ideas, infection, and oversized player power."
run/main_scene="res://scenes/city_poc.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.22, 0.14, 0.1, 1)
boot_splash/image="res://assets/branding/eccentricity_title.png"
boot_splash/stretch_mode=4
boot_splash/use_filter=true
boot_splash/minimum_display_time=800

[autoload]

ErrorOverlay="*res://scripts/debug/error_overlay.gd"
CityProfiler="*res://scripts/debug/city_profiler.gd"
DamageLog="*res://scripts/debug/damage_log.gd"

[debug]

; A GDScript that reaches through an untyped value is not checked at all until the line runs,
; so a wrong method name reached the running game and only showed up as a script error mid-play.
; At level 2 the analyzer refuses the script outright, which is what test_scripts_compile reads.
; res://addons is already excluded by the engine's default directory_rules.
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/humanoid_retarget/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="humans"
3d_physics/layer_3="vehicles"

[rendering]

anti_aliasing/quality/msaa_3d=0
scaling_3d/scale=0.75
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
