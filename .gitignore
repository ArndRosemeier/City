# Eccentri City — git tracking policy
#
# Default: TRACK EVERYTHING that belongs to the project.
# Exceptions MUST be listed explicitly below. If `tools/check_tracking.ps1`
# reports untracked files, either `git add` them or add a rule here.
#
# Player packages are built from `git ls-files` (see tools/pack_release.ps1),
# so untracked files never ship — and forgotten adds never silently work on
# your machine while breaking fresh clones.

# Godot 4+ generated cache (rebuilt by EccentriCity.bat / pack import)
.godot/
.godot_check_out/
*.translation

# Player Print Screen captures (project root while editing; next to .exe when exported)
screenshots/

# Legacy Godot 3 import cache name
.import/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors / IDE (project rules under .cursor/rules may be tracked deliberately)
.vscode/
.idea/
*.swp
*~

# Python tooling (asset generation)
__pycache__/
*.pyc
.venv/
venv/

# Large vendor downloads (Blender, MPFB zips, system assets)
tools/vendor/

# Local Godot voxel engine binary (downloaded by ensure_city_deps.ps1)
tools/godot/

# Portable install / pack output
dist/

# Mixamo raw FBX (Adobe terms — keep local; bake to mixamo_actions.tres)
assets/humans/animations/mixamo/raw/*.fbx
assets/humans/animations/mixamo/raw/*.FBX
assets/humans/animations/mixamo/raw/*.glb
assets/humans/animations/mixamo/raw/*.gltf
!assets/humans/animations/mixamo/raw/.gitkeep

# Rust / GDExtension build artifacts (ship Windows DLL in-repo for installers)
native/**/target/
addons/city_voxel/bin/*.so
addons/city_voxel/bin/*.dylib
addons/city_voxel/bin/*.pdb
!addons/city_voxel/bin/city_voxel.dll
!addons/city_voxel/bin/.gitkeep

# Tooling scratch / smoke logs
tools/_*.txt
tools/_*.txt.*
tools/*.log
tools/*.err
tools/crowd_test_out.txt
tools/godot_*.log
tools/pose_*.png
tools/pose_*.png.import
# Animated outfit inspection frames: 18 PNGs per outfit and clip set, ~30 MB a run, and
# regenerated by `run_test.ps1 shot_ped_animation -Rendered` whenever they are needed. The
# still lineup in tools/pedshots/ is the tracked reference.
tools/pedshots_anim/

# Blender / MakeHuman temp
*.blend1
*.blend2
*.mhm.bak

# Kenney kit extract / download scratch (fallback GLBs live under models/)
assets/vehicles/_kenney_src/
assets/vehicles/_kenney_tmp.zip
tools/_prop_src/

# Audio generation scratch HTML (not shipped)
assets/audio/tmp/
